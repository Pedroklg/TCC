# Repositórios oficiais do PetClinic — clonados em apps/ (ver README)
/apps/

# Resultados de execução do k6 e da análise (não versionados)
/results/
analysis/figures/
analysis/tables/
__pycache__/

# Saídas de build
**/target/
**/*.jar

# Terraform: estado (contém segredos; necessário p/ destroy) e cache
**/.terraform/
*.tfstate
*.tfstate.*
**/terraform.tfvars

# Serverless: artefatos do SAM
serverless/.aws-sam/
samconfig.toml

# Documento de planejamento interno (não publicado)
docs/fase7-aws.md

# Instruções locais do agente, resultados de execuções locais e provas de figura
/CLAUDE.md
/results-local/
/fig-preview/

# Misc
*.log
~$*.docx
infra/.env

docs/tcc/*

# Monografia LaTeX — versionada em repositório PRIVADO separado (não publicar no repo aberto)
/latex/
